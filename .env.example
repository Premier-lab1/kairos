# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Бэкенд (локально) — строка подключения к PostgreSQL
DATABASE_URL=postgresql://kairos@localhost:5434/kairos

# Источники данных
FRONTRUN_API_KEY=
HELIUS_API_KEY=

# Сервер (deploy/docker-compose.yml): пароли базы и read-only роли дашборда
POSTGRES_PASSWORD=
KAIROS_RO_PASSWORD=

# Telegram-бот: токен от @BotFather; BOT_ALLOWLIST — chat_id через запятую, none — никого, пусто — все
# TELEGRAM_BOT_TOKEN=
BOT_ALLOWLIST=none

# Объяснения «Why?» через Claude (console.anthropic.com); без ключа выключены
# ANTHROPIC_API_KEY=
